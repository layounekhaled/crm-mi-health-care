generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Prospect {
  id            String   @id @default(cuid())
  nom           String
  specialite    String?
  wilaya        String?
  telephone     String?
  telephone2    String?
  whatsapp      String?
  email         String?
  adresse       String?
  etablissement String?
  lienMaps      String?           // Lien Google Maps du lieu
  source        String?   @default("prospection")
  recommandePar   String?
  recommandeParId String?
  creeParId      String?    // Employee who created this prospect
  tarif         Int?       // 1, 2, or 3 — which price tier to apply
  isClient        Boolean   @default(false)
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  interactions  Interaction[]
  opportunities Opportunity[]
  afterSales    AfterSale[]
  eventLinks    EventProspect[]
  tasks         Task[]
  documentSends DocumentSend[]
  photos        ProspectPhoto[]
  creePar       Employee?  @relation("ProspectCreePar", fields: [creeParId], references: [id])
}

model Event {
  id           String   @id @default(cuid())
  nom          String
  ville        String?
  lienMaps     String?           // Lien Google Maps du lieu de l'événement
  date         DateTime          // Date de début
  dateFin      DateTime?         // Date de fin
  type         String    @default("congres")
  marques      String?
  equipe       String?
  notes        String?
  creeParId    String?           // Employee who created this event
  modifieParId String?           // Employee who last modified this event
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  prospects    EventProspect[]
  employees    EventEmployee[]
  tasks        Task[]
  creePar      Employee?  @relation("EventCreePar", fields: [creeParId], references: [id])
  modifiePar   Employee?  @relation("EventModifiePar", fields: [modifieParId], references: [id])
}

model EventProspect {
  id         String   @id @default(cuid())
  eventId    String
  prospectId String
  createdAt  DateTime @default(now())

  event    Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  prospect Prospect @relation(fields: [prospectId], references: [id], onDelete: Cascade)

  @@unique([eventId, prospectId])
}

model EventEmployee {
  id         String   @id @default(cuid())
  eventId    String
  employeeId String
  notified   Boolean  @default(false)
  createdAt  DateTime @default(now())

  event    Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([eventId, employeeId])
  @@index([employeeId])
}

model Opportunity {
  id            String    @id @default(cuid())
  clientId      String?
  nomProjet     String
  statut        String    @default("Nouveau")
  montantEstime Float?
  commercialId  String?
  creeParId     String?
  modifieParId  String?            // Employee who last modified this opportunity
  motifPerte    String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  client       Prospect?  @relation(fields: [clientId], references: [id])
  commercial   Employee?  @relation(fields: [commercialId], references: [id])
  creePar      Employee?  @relation("OpportunitesCrees", fields: [creeParId], references: [id])
  modifiePar   Employee?  @relation("OpportunitesModifiees", fields: [modifieParId], references: [id])
  operations   Operation[]
  tasks        Task[]
  interactions Interaction[]
  charges      Charge[]
}

model Operation {
  id            String   @id @default(cuid())
  opportunityId String
  produit       String
  marque        String
  produitId     String?  // Link to Product catalog
  responsableId String?
  prixEstime    Float?
  marge         Float?
  statut        String   @default("en_attente")
  datePrevue    DateTime?
  priorite      String   @default("moyenne")
  creeParId     String?           // Employee who created this operation
  modifieParId  String?           // Employee who last modified this operation
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  opportunity Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  responsable Employee?  @relation(fields: [responsableId], references: [id])
  produitRef  Product?   @relation(fields: [produitId], references: [id])
  tasks       Task[]
  creePar     Employee?  @relation("OperationCreePar", fields: [creeParId], references: [id])
  modifiePar  Employee?  @relation("OperationModifiePar", fields: [modifieParId], references: [id])
}

model Task {
  id            String    @id @default(cuid())
  titre         String
  type          String    @default("commerciale")
  assigneAId    String?   // Legacy: first assignee, kept for backward compat
  prospectId    String?
  opportunityId String?
  operationId   String?
  eventId       String?
  description   String?
  dateEcheance  DateTime?
  priorite      String    @default("moyenne")
  statut        String    @default("en_attente")
  creeParId     String?   // Employee who created the task
  modifieParId  String?   // Employee who last modified the task
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  assigneA    Employee?    @relation(fields: [assigneAId], references: [id])
  prospect    Prospect?    @relation(fields: [prospectId], references: [id])
  opportunity Opportunity? @relation(fields: [opportunityId], references: [id])
  operation   Operation?   @relation(fields: [operationId], references: [id])
  event       Event?       @relation(fields: [eventId], references: [id])
  creePar     Employee?    @relation("TaskCreator", fields: [creeParId], references: [id])
  modifiePar  Employee?    @relation("TaskModifier", fields: [modifieParId], references: [id])
  interactions Interaction[]
  assignees   TaskAssignee[]
}

model TaskAssignee {
  id         String   @id @default(cuid())
  taskId     String
  employeeId String
  createdAt  DateTime @default(now())

  task     Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([taskId, employeeId])
  @@index([employeeId])
}

model Interaction {
  id            String   @id @default(cuid())
  type          String   @default("appel")
  prospectId    String?
  opportunityId String?
  taskId        String?
  afterSaleId   String?
  notes         String?
  date          DateTime @default(now())
  employeId     String?
  createdAt     DateTime @default(now())

  prospect    Prospect?    @relation(fields: [prospectId], references: [id])
  opportunity Opportunity? @relation(fields: [opportunityId], references: [id])
  task        Task?        @relation(fields: [taskId], references: [id])
  afterSale   AfterSale?   @relation(fields: [afterSaleId], references: [id])
  employe     Employee?    @relation(fields: [employeId], references: [id])
  photos      InteractionPhoto[]

  @@index([taskId])
  @@index([afterSaleId])
}

model InteractionPhoto {
  id             String   @id @default(cuid())
  interactionId  String
  url            String
  pathname       String
  fileName       String
  fileSize       Int
  createdAt      DateTime @default(now())

  interaction Interaction @relation(fields: [interactionId], references: [id], onDelete: Cascade)

  @@index([interactionId])
}

model AfterSale {
  id           String   @id @default(cuid())
  clientId     String
  type         String   @default("livraison")
  statut       String   @default("en_attente")
  notes        String?
  date         DateTime?
  employeId    String?
  creeParId    String?           // Employee who created this after-sale
  modifieParId String?           // Employee who last modified this after-sale
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  client     Prospect @relation(fields: [clientId], references: [id])
  employe    Employee? @relation(fields: [employeId], references: [id])
  creePar    Employee? @relation("AfterSaleCreePar", fields: [creeParId], references: [id])
  modifiePar Employee? @relation("AfterSaleModifiePar", fields: [modifieParId], references: [id])
  interactions Interaction[]
}

model Employee {
  id          String   @id @default(cuid())
  nom         String
  email       String?
  telephone   String?
  role        String   @default("commercial")
  permissions Json?    // Granular permissions: { module: { action: true/false } }
  actif       Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  opportunities       Opportunity[]
  opportunitesModifiees Opportunity[] @relation("OpportunitesModifiees")
  operations          Operation[]
  operationsCrees     Operation[]  @relation("OperationCreePar")
  operationsModifiees Operation[]  @relation("OperationModifiePar")
  tasksAssigned       Task[]
  taskAssignments     TaskAssignee[]
  createdTasks        Task[]       @relation("TaskCreator")
  tasksModifiees      Task[]       @relation("TaskModifier")
  interactions        Interaction[]
  afterSales          AfterSale[]
  afterSalesCrees     AfterSale[]  @relation("AfterSaleCreePar")
  afterSalesModifiees AfterSale[]  @relation("AfterSaleModifiePar")
  objectives          Objective[]
  user                User?
  chatParticipants    ChatParticipant[]
  sentMessages        ChatMessage[]
  emailConfig         EmailConfig?
  leaveRequests       LeaveRequest[]
  approvedRequests    LeaveRequest[] @relation("ApprovedRequests")
  leaveMovements      LeaveMovement[]
  documents           Document[]   @relation("DocumentUploader")
  documentsModifies   Document[]   @relation("DocumentModifiePar")
  documentSends       DocumentSend[]
  chargesAsEmployee   Charge[] @relation("EmployeeCharges")
  chargesAsCreator    Charge[] @relation("ChargeCreator")
  chargesModifiees    Charge[] @relation("ChargeModifier")
  uploadedPhotos      ProspectPhoto[]
  eventParticipations EventEmployee[]
  eventsCrees         Event[]      @relation("EventCreePar")
  eventsModifies      Event[]      @relation("EventModifiePar")
  prospectsCrees      Prospect[]  @relation("ProspectCreePar")
  opportunitesCrees   Opportunity[] @relation("OpportunitesCrees")
}

model Objective {
  id              String   @id @default(cuid())
  employeId       String
  mois            String
  caObjectif      Float?   @default(0)
  nbVentesObjectif Int?    @default(0)
  tachesObjectif  Int?     @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  employe Employee @relation(fields: [employeId], references: [id], onDelete: Cascade)

  @@unique([employeId, mois])
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  motDePasse   String
  employeId    String?  @unique
  role         String   @default("commercial")
  permissions  Json?    // Cached permissions from Employee
  actif        Boolean  @default(true)
  derniereConnexion DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  employe      Employee?  @relation(fields: [employeId], references: [id])
  notifications Notification[]
}

model Notification {
  id          String   @id @default(cuid())
  userId      String
  type        String   @default("info")
  titre       String
  message     String
  lue         Boolean  @default(false)
  lien        String?
  referenceId String?
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, lue])
}

model ChatConversation {
  id        String   @id @default(cuid())
  type      String   @default("direct")   // "direct" or "group"
  nom       String?                        // Group name (optional for direct)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  participants ChatParticipant[]
  messages     ChatMessage[]

  @@index([updatedAt])
}

model ChatParticipant {
  id             String   @id @default(cuid())
  conversationId String
  employeId      String
  lastReadAt     DateTime @default(now())
  createdAt      DateTime @default(now())

  conversation ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  employe      Employee         @relation(fields: [employeId], references: [id], onDelete: Cascade)

  @@unique([conversationId, employeId])
  @@index([employeId])
}

model ChatMessage {
  id             String   @id @default(cuid())
  conversationId String
  expediteurId   String
  contenu        String
  createdAt      DateTime @default(now())

  conversation ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  expediteur   Employee         @relation(fields: [expediteurId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([expediteurId])
}

model EmailConfig {
  id             String   @id @default(cuid())
  employeId      String   @unique
  email          String
  imapHost       String?
  imapPort       Int      @default(993)
  imapTls        Boolean  @default(true)
  smtpHost       String?
  smtpPort       Int      @default(587)
  smtpTls        Boolean  @default(true)
  emailPassword  String?
  signature      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  employe Employee @relation(fields: [employeId], references: [id], onDelete: Cascade)
}

model LeaveRequest {
  id            String   @id @default(cuid())
  employeeId    String
  type          String   // leave / absence / recovery_work
  startDate     DateTime
  endDate       DateTime
  daysCount     Int
  reason        String?
  attachmentUrl String?
  status        String   @default("pending") // pending / approved / rejected
  adminComment  String?
  approvedBy    String?
  approvedAt    DateTime?
  createdAt     DateTime @default(now())

  employee  Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  approver  Employee? @relation("ApprovedRequests", fields: [approvedBy], references: [id])
  movements LeaveMovement[]

  @@index([employeeId])
  @@index([status])
  @@index([type])
}

model LeaveMovement {
  id         String   @id @default(cuid())
  employeeId String
  type       String   // leave / absence / recovery / annual_credit / adjustment
  value      Int      // +N or -N
  sourceId   String?  // reference to LeaveRequest id
  date       DateTime @default(now())
  createdAt  DateTime @default(now())

  employee Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  source   LeaveRequest? @relation(fields: [sourceId], references: [id])

  @@index([employeeId])
  @@index([type])
  @@index([date])
}

model CalendarDay {
  id        String   @id @default(cuid())
  date      DateTime @unique
  type      String   // working_day / weekend / holiday
  label     String?  // e.g. "Jour de l'an", "Fête de l'indépendance"
  createdAt DateTime @default(now())

  @@index([date])
  @@index([type])
}

model Product {
  id             String   @id @default(cuid())
  nom            String
  marque         String   // MIR / BOS / Löwenstein / Yuwell / Gelenke / Autres
  categorie      String?  // monitorage / ventilation / chirurgie / imagerie / etc.
  reference      String?
  description    String?
  prix1          Float?   // Tarif 1
  prix2          Float?   // Tarif 2
  prix3          Float?   // Tarif 3
  actif          Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  operations     Operation[]

  @@index([marque])
  @@index([categorie])
  @@index([actif])
}

model Document {
  id            String   @id @default(cuid())
  title         String
  description   String?
  brand         String   // MIR / BOS / Löwenstein / Yuwell / Gelenke / Autres
  productName   String?
  documentType  String   // catalogue / prospectus / fiche_technique / formation / sav / autre
  fileUrl       String   // URL publique Supabase
  filePath      String   // chemin storage
  fileName      String
  fileSize      Int      // en octets
  uploadedBy    String?  // employeId who uploaded (created) the document
  modifieParId  String?  // employeId who last modified the document
  status        String   @default("active") // active / archived
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  uploader     Employee?     @relation("DocumentUploader", fields: [uploadedBy], references: [id])
  modifiePar   Employee?     @relation("DocumentModifiePar", fields: [modifieParId], references: [id])

  @@index([brand])
  @@index([documentType])
  @@index([status])
}

model DocumentSend {
  id            String   @id @default(cuid())
  documentIds   String   // JSON array of document IDs
  sentBy        String?  // employeId
  recipientType String   // prospect / client / manual
  recipientId   String?  // prospect/client ID
  recipientEmail String
  message       String?
  sentAt        DateTime @default(now())
  status        String   @default("sent") // sent / failed

  sender   Employee? @relation(fields: [sentBy], references: [id])
  prospect Prospect? @relation(fields: [recipientId], references: [id])

  @@index([sentBy])
  @@index([recipientId])
  @@index([sentAt])
}

model Charge {
  id             String    @id @default(cuid())
  type           String    // hotel / restaurant / transport / divers
  montant        Float     // amount in DZD
  description    String?
  date           DateTime  @default(now())
  employeId      String    // the employee who incurred the expense
  opportunityId  String?   // optional: link to an opportunity
  createdBy      String?   // employeId of who recorded it
  modifieParId   String?   // employeId who last modified the charge
  justificatifUrl String?  // URL du justificatif (bon, ticket, reçu)
  isPrivate      Boolean   @default(false) // admin-only: personal charge invisible to others
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  employe     Employee     @relation("EmployeeCharges", fields: [employeId], references: [id])
  opportunity Opportunity? @relation(fields: [opportunityId], references: [id])
  creator     Employee?    @relation("ChargeCreator", fields: [createdBy], references: [id])
  modifiePar  Employee?    @relation("ChargeModifier", fields: [modifieParId], references: [id])

  @@index([employeId])
  @@index([opportunityId])
  @@index([type])
  @@index([date])
}

model ProspectPhoto {
  id          String   @id @default(cuid())
  prospectId  String
  url         String   // Vercel Blob URL
  pathname    String   // Blob pathname for deletion
  fileName    String   // Original file name
  fileSize    Int      // Size in bytes
  legend      String?  // Optional caption/description
  uploadedBy  String?  // employeId
  createdAt   DateTime @default(now())

  prospect Prospect  @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  uploader Employee? @relation(fields: [uploadedBy], references: [id])

  @@index([prospectId])
  @@index([createdAt])
}
